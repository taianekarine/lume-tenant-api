generator client {
  provider            = "prisma-client"
  output              = "../src/infra/database/prisma/generated"
  runtime             = "nodejs"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

model Company {
  id        String        @id @db.Uuid
  legalName String        @map("legal_name") @db.VarChar(160)
  tradeName String?       @map("trade_name") @db.VarChar(120)
  taxId     String        @unique @map("tax_id") @db.VarChar(14)
  status    CompanyStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  users     User[]
  roles     Role[]
  auditLogs TenantAuditLog[]

  @@map("companies")
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  companyId          String    @map("company_id") @db.Uuid
  name               String    @db.VarChar(120)
  username           String    @db.VarChar(40)
  usernameNormalized String    @unique @map("username_normalized") @db.VarChar(40)
  email              String    @db.VarChar(254)
  emailNormalized    String    @unique @map("email_normalized") @db.VarChar(254)
  cpfNormalized      String?   @unique @map("cpf_normalized") @db.VarChar(11)
  passwordHash       String    @map("password_hash") @db.VarChar(100)
  departments        String[]  @default([])
  isActive           Boolean   @default(true) @map("is_active")
  tokenVersion       Int       @default(1) @map("token_version")
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  roles         UserRole[]
  refreshTokens RefreshToken[]
  auditLogs     TenantAuditLog[]

  @@unique([id, companyId])
  @@index([companyId])
  @@map("users")
}

model Role {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  code            String   @db.VarChar(60)
  name            String   @db.VarChar(80)
  description     String?  @db.VarChar(240)
  permissionCodes String[] @default([]) @map("permission_codes")
  isSystem        Boolean  @default(false) @map("is_system")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  company Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users   UserRole[]

  @@unique([companyId, code])
  @@unique([id, companyId])
  @@index([companyId])
  @@map("roles")
}

model UserRole {
  companyId String   @map("company_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId, companyId], references: [id, companyId], onDelete: Cascade)
  role Role @relation(fields: [roleId, companyId], references: [id, companyId], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([companyId])
  @@index([roleId, companyId])
  @@map("user_roles")
}

model RefreshToken {
  id             String    @id @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash") @db.Char(64)
  rememberDevice Boolean   @default(false) @map("remember_device")
  expiresAt      DateTime  @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([userId, companyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model TenantAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(80)
  targetType  String   @map("target_type") @db.VarChar(40)
  targetId    String   @map("target_id") @db.VarChar(100)
  metadata    Json     @default("{}") @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("tenant_audit_logs")
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  aggregateType String       @map("aggregate_type") @db.VarChar(60)
  aggregateId   String       @map("aggregate_id") @db.VarChar(100)
  eventType     String       @map("event_type") @db.VarChar(100)
  payload       Json         @db.JsonB
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now()) @map("available_at")
  deliveredAt   DateTime?    @map("delivered_at")
  lastError     String?      @map("last_error") @db.Text
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([status, availableAt])
  @@map("outbox_events")
}

model InboxReceipt {
  eventId    String   @id @map("event_id") @db.Uuid
  source     String   @db.VarChar(80)
  receivedAt DateTime @default(now()) @map("received_at")

  @@map("inbox_receipts")
}
