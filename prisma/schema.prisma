generator client {
  provider            = "prisma-client"
  output              = "../src/infra/database/prisma/generated"
  runtime             = "nodejs"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
}

enum RoutingCompanyStatus {
  ACTIVE    @map("active")
  INACTIVE  @map("inactive")
  SUSPENDED @map("suspended")
}

enum RoutingClientType {
  PF @map("pf")
  PJ @map("pj")
}

enum RoutingFixedPointStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")
}

enum PassengerStatus {
  ACTIVE                @map("active")
  ON_LEAVE              @map("on-leave")
  VACATION              @map("vacation")
  TEMPORARILY_OFF_ROUTE @map("temporarily-off-route")
  UNLINKED              @map("unlinked")
}

enum PassengerRegistrationStatus {
  READY   @map("ready")
  PENDING @map("pending")
}

enum RoutingDataOrigin {
  COMPANY    @map("company")
  AGENT      @map("agent")
  OPERATIONS @map("operations")
  IMPORT     @map("import")
  SYSTEM     @map("system")
}

enum PassengerIssueStatus {
  OPEN     @map("open")
  RESOLVED @map("resolved")
}

enum PassengerImportBatchStatus {
  PROCESSING      @map("processing")
  COMPLETED       @map("completed")
  REVIEW_REQUIRED @map("review-required")
  FAILED          @map("failed")
}

enum PassengerImportAction {
  CREATED  @map("created")
  UPDATED  @map("updated")
  KEPT     @map("kept")
  CONFLICT @map("conflict")
  PENDING  @map("pending")
}

enum RoutingRouteType {
  MUNICIPAL     @map("municipal")
  INTERMUNICIPAL @map("intermunicipal")
}

enum RoutingRouteStatus {
  DRAFT            @map("draft")
  ROUTED           @map("routed")
  IN_REVIEW        @map("in-review")
  PENDING_APPROVAL @map("pending-approval")
  APPROVED         @map("approved")
  PUBLISHED        @map("published")
}

enum RoutingDirection {
  OUTBOUND @map("outbound")
  RETURN   @map("return")
}

enum RoutingAssignmentStatus {
  ASSIGNED          @map("assigned")
  OVERFLOW          @map("overflow")
  PENDING_DATA      @map("pending-data")
  PENDING_DOCUMENTS @map("pending-documents")
}

enum RoutingContractStatus {
  DRAFT     @map("draft")
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")
  ENDED     @map("ended")
}

enum RoutingContractPeriodicity {
  MONTHLY   @map("monthly")
  WEEKLY    @map("weekly")
  DAILY     @map("daily")
  PER_ROUTE @map("per-route")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

enum DepartmentCode {
  CLIENT_COMPANY          @map("client-company")
  HUMAN_RESOURCES        @map("human-resources")
  PERSONNEL_DEPARTMENT   @map("personnel-department")
  COMMERCIAL             @map("commercial")
  PURCHASING             @map("purchasing")
  CONTROLLING            @map("controlling")
  MAINTENANCE            @map("maintenance")
  MONITORING             @map("monitoring")
  MANAGEMENT             @map("management")
  OPERATIONS             @map("operations")
  CLEANING               @map("cleaning")
  FINANCIAL              @map("financial")
  INFORMATION_TECHNOLOGY @map("information-technology")
}

enum ConversationState {
  BOT_ACTIVE           @map("bot-active")
  WAITING_FOR_CUSTOMER @map("waiting-for-customer")
  SENT_TO_HUMAN        @map("sent-to-human")
  HUMAN_ACTIVE         @map("human-active")
  CLOSED               @map("closed")
}

enum FlowStep {
  MAIN_MENU                  @map("main-menu")
  COMMERCIAL_MENU            @map("commercial-menu")
  QUOTE_DATA_COLLECTION      @map("quote-data-collection")
  QUOTE_SUMMARY_CONFIRMATION @map("quote-summary-confirmation")
  QUOTE_SEND_PENDING         @map("quote-send-pending")
  COMMERCIAL_FOLLOW_UP_MENU  @map("commercial-follow-up-menu")
  HUMAN_SERVICE              @map("human-service")
  CLOSED                     @map("closed")
}

enum RequestStatus {
  NOT_STARTED            @map("not-started")
  COLLECTING_INFORMATION @map("collecting-information")
  WAITING_FOR_CUSTOMER   @map("waiting-for-customer")
  UNDER_REVIEW           @map("under-review")
  APPROVED               @map("approved")
  REJECTED               @map("rejected")
  CANCELLED              @map("cancelled")
}

enum MessageDirection {
  INBOUND  @map("inbound")
  OUTBOUND @map("outbound")
}

enum DeliveryStatus {
  RECEIVED  @map("received")
  PENDING   @map("pending")
  SENT      @map("sent")
  DELIVERED @map("delivered")
  READ      @map("read")
  FAILED    @map("failed")
}

enum MessageKind {
  TEXT     @map("text")
  IMAGE    @map("image")
  DOCUMENT @map("document")
  AUDIO    @map("audio")
  VIDEO    @map("video")
  STICKER  @map("sticker")
  LOCATION @map("location")
  CONTACT  @map("contact")
  UNKNOWN  @map("unknown")
}

enum MessageAttemptStatus {
  PENDING   @map("pending")
  SUCCEEDED @map("succeeded")
  FAILED    @map("failed")
}

enum EvolutionDispatchState {
  READY     @map("ready")
  LEASED    @map("leased")
  UNKNOWN   @map("unknown")
  SUCCEEDED @map("succeeded")
  FAILED    @map("failed")
}

enum TransitionActorType {
  USER    @map("user")
  N8N     @map("n8n")
  WEBHOOK @map("webhook")
  SYSTEM  @map("system")
}

enum IntegrationOutboxStatus {
  PENDING    @map("pending")
  PROCESSING @map("processing")
  DELIVERED  @map("delivered")
  DEAD       @map("dead")
}

enum WhatsAppAutomationProvider {
  N8N @map("n8n")
  API @map("api")
}

enum WhatsAppAutomationExecutionStatus {
  CLAIMED           @map("claimed")
  ACCEPTED          @map("accepted")
  SUCCEEDED         @map("succeeded")
  RETRYABLE_FAILURE @map("retryable-failure")
  TERMINAL_FAILURE  @map("terminal-failure")
}

enum QuoteProposalDocumentStatus {
  UPLOADED @map("uploaded")
  QUEUED   @map("queued")
  SENT     @map("sent")
  FAILED   @map("failed")
}

enum WhatsAppProviderType {
  EVOLUTION @map("evolution")
}

enum ServiceIdentityType {
  N8N @map("n8n")
}

enum PasswordChangeReason {
  FIRST_ACCESS @map("first-access")
  ADMIN_RESET  @map("admin-reset")
}

enum UserAccountStatus {
  ACTIVE    @map("active")
  INACTIVE  @map("inactive")
  SUSPENDED @map("suspended")
}

enum WhatsAppImportBatchStatus {
  APPLYING    @map("applying")
  APPLIED     @map("applied")
  FAILED      @map("failed")
  ROLLED_BACK @map("rolled-back")
}

enum WhatsAppImportRecordStatus {
  APPLIED     @map("applied")
  ROLLED_BACK @map("rolled-back")
}

enum DataExchangeArtifactKind {
  UPLOAD     @map("upload")
  CONVERSION @map("conversion")
}

enum DocumentAccessMode {
  STANDARD        @map("standard")
  DOCUMENT_PORTAL @map("document-portal")
  CLIENT          @map("client")
}

enum UserClientCategory {
  LEGAL_ENTITY @map("legal-entity")
  INDIVIDUAL   @map("individual")
}

enum DocumentRequestContext {
  ADMISSION        @map("admission")
  DOCUMENT_UPDATE  @map("document-update")
  DOCUMENT_RENEWAL @map("document-renewal")
  REGULARIZATION   @map("regularization")
  OFFBOARDING      @map("offboarding")
  OTHER            @map("other")
}

enum DocumentRequestStatus {
  DRAFT                 @map("draft")
  PENDING_UPLOAD        @map("pending-upload")
  PARTIALLY_SUBMITTED   @map("partially-submitted")
  SUBMITTED             @map("submitted")
  AUTOMATIC_VALIDATION  @map("automatic-validation")
  PENDING_HUMAN_REVIEW  @map("pending-human-review")
  RESUBMISSION_REQUIRED @map("resubmission-required")
  APPROVED              @map("approved")
  REJECTED              @map("rejected")
  EXPIRED               @map("expired")
  CANCELLED             @map("cancelled")
}

enum DocumentItemStatus {
  PENDING_UPLOAD        @map("pending-upload")
  SUBMITTED             @map("submitted")
  AUTOMATIC_VALIDATION  @map("automatic-validation")
  PENDING_HUMAN_REVIEW  @map("pending-human-review")
  RESUBMISSION_REQUIRED @map("resubmission-required")
  APPROVED              @map("approved")
  REJECTED              @map("rejected")
  EXPIRED               @map("expired")
  WAIVED                @map("waived")
  CANCELLED             @map("cancelled")
}

enum DocumentRequirement {
  REQUIRED    @map("required")
  OPTIONAL    @map("optional")
  CONDITIONAL @map("conditional")
}

enum DocumentFileSide {
  SINGLE @map("single")
  FRONT  @map("front")
  BACK   @map("back")
  PAGE   @map("page")
}

enum DocumentValidationStatus {
  PENDING    @map("pending")
  PROCESSING @map("processing")
  COMPLETED  @map("completed")
  FAILED     @map("failed")
}

enum DocumentReviewDecision {
  APPROVED              @map("approved")
  REJECTED              @map("rejected")
  RESUBMISSION_REQUIRED @map("resubmission-required")
}

enum DocumentOriginalCheckStatus {
  NOT_REQUIRED @map("not-required")
  PENDING      @map("pending")
  CONFIRMED    @map("confirmed")
  DIVERGENT    @map("divergent")
}

model Company {
  id        String        @id @db.Uuid
  legalName String        @map("legal_name") @db.VarChar(160)
  tradeName String?       @map("trade_name") @db.VarChar(120)
  taxId     String        @unique @map("tax_id") @db.VarChar(14)
  status    CompanyStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  users                         User[]
  auditLogs                     TenantAuditLog[]
  departments                   TenantDepartment[]
  whatsappProviders             WhatsAppProvider[]
  whatsappChannels              WhatsAppChannel[]
  whatsappContacts              WhatsAppContact[]
  whatsappConversations         WhatsAppConversation[]
  whatsappMessages              WhatsAppMessage[]
  whatsappMessageAttempts       WhatsAppMessageAttempt[]
  whatsappTransitions           WhatsAppConversationTransition[]
  quoteRequests                 QuoteRequest[]
  quoteProposalDocuments        QuoteProposalDocument[]
  quoteNotificationReads        QuoteNotificationRead[]
  integrationInbox              IntegrationInbox[]
  integrationOutbox             IntegrationOutbox[]
  whatsappAutomationExecutions  WhatsAppAutomationExecution[]
  whatsappAutomationDecisions   WhatsAppAutomationDecision[]
  whatsappAutomationCheckpoints WhatsAppAutomationCheckpoint[]
  serviceIdentities             ServiceIdentity[]
  passwordChangeChallenges      PasswordChangeChallenge[]
  passwordHistory               UserPasswordHistory[]
  whatsappImportBatches         WhatsAppImportBatch[]
  whatsappImportRecords         WhatsAppImportRecord[]
  whatsappImportExternalRefs    WhatsAppImportExternalRef[]
  dataExchangeArtifacts         DataExchangeArtifact[]
  documentTypes                 DocumentType[]
  documentChecklistTemplates    DocumentChecklistTemplate[]
  documentChecklistItems        DocumentChecklistItem[]
  documentRequests              DocumentRequest[]
  documentRequestItems          DocumentRequestItem[]
  documentSubmissions           DocumentSubmission[]
  documentFiles                 DocumentFile[]
  documentValidations           DocumentValidation[]
  documentReviews               DocumentReview[]
  documentStatusHistory         DocumentStatusHistory[]
  apiRequestMetrics             ApiRequestMetric[]
  routingCompanies              RoutingCompany[]
  routingCompanyHistoryEntries RoutingCompanyHistory[]
  routingCompanyComments       RoutingCompanyComment[]
  passengers                    Passenger[]
  passengerHistoryEntries      PassengerHistory[]
  passengerIssues              PassengerIssue[]
  passengerDocumentData        PassengerDocumentData[]
  passengerImportBatches       PassengerImportBatch[]
  passengerImportRecords       PassengerImportRecord[]
  routingRoutes                 RoutingRoute[]
  routingRoutePoints           RoutingRoutePoint[]
  routingRouteAssignments      RoutingRoutePassenger[]
  routingRouteHistoryEntries   RoutingRouteHistory[]
  routingRouteVersions         RoutingRouteVersion[]
  routingRouteApprovals        RoutingRouteApproval[]
  routingNavigationLinks       RoutingNavigationLink[]
  routingExecutions            RoutingRouteExecution[]
  routingContracts             RoutingContract[]
  routingContractCostCenters   RoutingContractCostCenter[]
  routingContractShifts        RoutingContractShift[]
  routingContractHistoryEntries RoutingContractHistory[]
  routingFixedPoints             RoutingFixedPoint[]

  @@map("companies")
}

model User {
  id                     String             @id @default(uuid()) @db.Uuid
  companyId              String             @map("company_id") @db.Uuid
  routingCompanyId       String?            @map("routing_company_id") @db.Uuid
  name                   String             @db.VarChar(120)
  username               String             @db.VarChar(40)
  usernameNormalized     String             @unique @map("username_normalized") @db.VarChar(40)
  email                  String             @db.VarChar(254)
  emailNormalized        String             @unique @map("email_normalized") @db.VarChar(254)
  cpfNormalized          String?            @unique @map("cpf_normalized") @db.VarChar(11)
  passwordHash           String             @map("password_hash") @db.VarChar(100)
  mustChangePassword     Boolean            @default(false) @map("must_change_password")
  profilePicture         Bytes?             @map("profile_picture")
  profilePictureMime     String?            @map("profile_picture_mime") @db.VarChar(40)
  isAdministrator        Boolean            @default(false) @map("is_administrator")
  documentAccessMode     DocumentAccessMode @default(STANDARD) @map("document_access_mode")
  clientCategory         UserClientCategory? @map("client_category")
  jobTitle               String?            @map("job_title") @db.VarChar(120)
  maritalStatus          String?            @map("marital_status") @db.VarChar(30)
  militaryDocumentStatus String             @default("pending-confirmation") @map("military_document_status") @db.VarChar(30)
  dependents             Json               @default("[]") @db.JsonB
  departments            String[]           @default([])
  permissionCodes        String[]           @default([]) @map("permission_codes")
  status                 UserAccountStatus  @default(ACTIVE)
  suspendedUntil         DateTime?          @map("suspended_until")
  suspensionReason       String?            @map("suspension_reason") @db.VarChar(500)
  isActive               Boolean            @default(true) @map("is_active")
  deletedAt              DateTime?          @map("deleted_at") @db.Timestamptz(3)
  tokenVersion           Int                @default(1) @map("token_version")
  lastLoginAt            DateTime?          @map("last_login_at")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  company                       Company                          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  routingCompany                RoutingCompany?                  @relation("RoutingCompanyUsers", fields: [routingCompanyId, companyId], references: [id, companyId], onDelete: NoAction)
  createdRoutingCompanies       RoutingCompany[]                 @relation("RoutingCompanyCreator")
  routingCompanyHistoryEntries RoutingCompanyHistory[]          @relation("RoutingCompanyHistoryActor")
  createdRoutingCompanyComments RoutingCompanyComment[]          @relation("RoutingCompanyCommentCreator")
  updatedRoutingCompanyComments RoutingCompanyComment[]          @relation("RoutingCompanyCommentUpdater")
  createdPassengers            Passenger[]                       @relation("PassengerCreator")
  passengerHistoryEntries      PassengerHistory[]                @relation("PassengerHistoryActor")
  passengerImportBatches       PassengerImportBatch[]            @relation("PassengerImportActor")
  createdRoutingRoutes         RoutingRoute[]                     @relation("RoutingRouteCreator")
  routingRouteHistoryEntries   RoutingRouteHistory[]              @relation("RoutingRouteHistoryActor")
  routingRouteApprovals        RoutingRouteApproval[]             @relation("RoutingRouteApprover")
  publishedRoutingRoutes       RoutingRoute[]                     @relation("RoutingRoutePublisher")
  createdRoutingContracts      RoutingContract[]                  @relation("RoutingContractCreator")
  routingContractHistoryEntries RoutingContractHistory[]          @relation("RoutingContractHistoryActor")
  createdRoutingFixedPoints     RoutingFixedPoint[]                 @relation("RoutingFixedPointCreator")
  refreshTokens                 RefreshToken[]
  auditLogs                     TenantAuditLog[]
  assignedWhatsappConversations WhatsAppConversation[]           @relation("ConversationAssignee")
  uploadedQuoteProposals        QuoteProposalDocument[]          @relation("QuoteProposalUploader")
  requestedQuoteProposals       QuoteRequest[]                   @relation("QuoteProposalRequester")
  decidedQuoteProposals         QuoteRequest[]                   @relation("QuoteProposalDecider")
  sentQuoteProposals            QuoteProposalDocument[]          @relation("QuoteProposalSender")
  sentWhatsappMessages          WhatsAppMessage[]                @relation("WhatsAppMessageActor")
  quoteNotificationReads        QuoteNotificationRead[]
  whatsappTransitions           WhatsAppConversationTransition[] @relation("TransitionActorUser")
  passwordChangeChallenges      PasswordChangeChallenge[]
  passwordHistory               UserPasswordHistory[]
  whatsappImportBatches         WhatsAppImportBatch[]            @relation("WhatsAppImportActor")
  dataExchangeArtifacts         DataExchangeArtifact[]           @relation("DataExchangeArtifactUploader")
  subjectDocumentRequests       DocumentRequest[]                @relation("DocumentRequestSubject")
  createdDocumentRequests       DocumentRequest[]                @relation("DocumentRequestCreator")
  createdChecklistTemplates     DocumentChecklistTemplate[]      @relation("DocumentChecklistCreator")
  submittedDocuments            DocumentSubmission[]             @relation("DocumentSubmissionAuthor")
  uploadedDocumentFiles         DocumentFile[]                   @relation("DocumentFileUploader")
  documentReviews               DocumentReview[]                 @relation("DocumentReviewer")
  documentStatusChanges         DocumentStatusHistory[]          @relation("DocumentStatusActor")
  apiRequestMetrics             ApiRequestMetric[]

  @@unique([id, companyId])
  @@index([companyId])
  @@index([companyId, routingCompanyId])
  @@index([companyId, status, name])
  @@index([companyId, deletedAt])
  @@index([departments], type: Gin)
  @@index([permissionCodes], type: Gin)
  @@map("users")
}

model RoutingCompany {
  id               String               @id @default(uuid()) @db.Uuid
  companyId        String               @map("company_id") @db.Uuid
  taxId            String               @map("tax_id") @db.VarChar(14)
  legalName        String               @map("legal_name") @db.VarChar(160)
  tradeName        String?              @map("trade_name") @db.VarChar(120)
  costCenter       String?              @map("cost_center") @db.VarChar(120)
  clientType       RoutingClientType    @default(PJ) @map("client_type")
  individualName  String?              @map("individual_name") @db.VarChar(160)
  cpf              String?              @db.VarChar(11)
  individualEmail String?              @map("individual_email") @db.VarChar(254)
  individualWhatsapp String?           @map("individual_whatsapp") @db.VarChar(20)
  individualPhones Json                @default("[]") @map("individual_phones") @db.JsonB
  cnpj             String?              @db.VarChar(14)
  legalEmail       String?              @map("legal_email") @db.VarChar(254)
  legalWhatsapp    String?              @map("legal_whatsapp") @db.VarChar(20)
  legalPhones      Json                 @default("[]") @map("legal_phones") @db.JsonB
  status           RoutingCompanyStatus @default(ACTIVE)
  avicExternalId   String?              @map("avic_external_id") @db.VarChar(160)
  avicLastSyncedAt DateTime?            @map("avic_last_synced_at") @db.Timestamptz(3)
  version          Int                  @default(1)
  createdByUserId  String?              @map("created_by_user_id") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("RoutingCompanyCreator", fields: [createdByUserId, companyId], references: [id, companyId], onDelete: NoAction)
  users     User[]  @relation("RoutingCompanyUsers")
  history   RoutingCompanyHistory[]
  comments  RoutingCompanyComment[]
  passengers Passenger[]
  importRecords PassengerImportRecord[]
  routes RoutingRoute[]
  contracts RoutingContract[]
  fixedPoints RoutingFixedPoint[]

  @@unique([id, companyId])
  @@unique([companyId, taxId])
  @@unique([companyId, cpf])
  @@unique([companyId, cnpj])
  @@unique([companyId, avicExternalId])
  @@index([companyId, status, legalName])
  @@map("routing_companies")
}

model RoutingCompanyComment {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  routingCompanyId String   @map("routing_company_id") @db.Uuid
  comment          String   @db.Text
  createdByUserId  String   @map("created_by_user_id") @db.Uuid
  updatedByUserId  String   @map("updated_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  routingCompany RoutingCompany @relation(fields: [routingCompanyId, companyId], references: [id, companyId], onDelete: Cascade)
  createdBy      User           @relation("RoutingCompanyCommentCreator", fields: [createdByUserId, companyId], references: [id, companyId], onDelete: NoAction)
  updatedBy      User           @relation("RoutingCompanyCommentUpdater", fields: [updatedByUserId, companyId], references: [id, companyId], onDelete: NoAction)

  @@unique([id, companyId])
  @@index([companyId, routingCompanyId, createdAt])
  @@map("routing_company_comments")
}

model RoutingFixedPoint {
  id               String                  @id @default(uuid()) @db.Uuid
  companyId        String                  @map("company_id") @db.Uuid
  routingCompanyId String?                 @map("routing_company_id") @db.Uuid
  code             String                  @db.VarChar(24)
  name             String                  @db.VarChar(160)
  status           RoutingFixedPointStatus @default(ACTIVE)
  street           String                  @db.VarChar(160)
  number           String                  @db.VarChar(30)
  complement       String?                 @db.VarChar(120)
  district         String                  @db.VarChar(120)
  postalCode       String                  @map("postal_code") @db.VarChar(8)
  city             String                  @db.VarChar(120)
  state            String                  @db.Char(2)
  latitude         Decimal?                @db.Decimal(10, 7)
  longitude        Decimal?                @db.Decimal(10, 7)
  version          Int                     @default(1)
  createdByUserId  String                  @map("created_by_user_id") @db.Uuid
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  company                Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  routingCompany         RoutingCompany?   @relation(fields: [routingCompanyId, companyId], references: [id, companyId], onDelete: NoAction)
  createdBy              User              @relation("RoutingFixedPointCreator", fields: [createdByUserId, companyId], references: [id, companyId], onDelete: NoAction)
  originContracts        RoutingContract[] @relation("RoutingContractOriginFixedPoint")
  destinationContracts   RoutingContract[] @relation("RoutingContractDestinationFixedPoint")
  passengers             Passenger[]
  routePoints            RoutingRoutePoint[]

  @@unique([id, companyId])
  @@unique([companyId, code])
  @@index([companyId, routingCompanyId, status, name])
  @@map("routing_fixed_points")
}

model RoutingCompanyHistory {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  routingCompanyId String   @map("routing_company_id") @db.Uuid
  actorUserId      String?  @map("actor_user_id") @db.Uuid
  commandId        String   @map("command_id") @db.Uuid
  action           String   @db.VarChar(80)
  beforeSnapshot   Json?    @map("before_snapshot") @db.JsonB
  afterSnapshot    Json     @map("after_snapshot") @db.JsonB
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  routingCompany RoutingCompany @relation(fields: [routingCompanyId, companyId], references: [id, companyId], onDelete: Cascade)
  actor          User?          @relation("RoutingCompanyHistoryActor", fields: [actorUserId, companyId], references: [id, companyId], onDelete: NoAction)

  @@unique([companyId, commandId])
  @@index([companyId, routingCompanyId, createdAt])
  @@map("routing_company_history")
}

model Passenger {
  id                              String                      @id @default(uuid()) @db.Uuid
  companyId                       String                      @map("company_id") @db.Uuid
  routingCompanyId                String                      @map("routing_company_id") @db.Uuid
  externalReference               String?                     @map("external_reference") @db.VarChar(120)
  identityFingerprint             String                      @map("identity_fingerprint") @db.Char(64)
  fullName                        String                      @map("full_name") @db.VarChar(160)
  normalizedName                  String                      @map("normalized_name") @db.VarChar(160)
  shift                           String?                     @db.VarChar(80)
  requiredArrivalTime             String?                     @map("required_arrival_time") @db.Char(5)
  sector                          String?                     @db.VarChar(120)
  accessibilityRequired           Boolean                     @default(false) @map("accessibility_required")
  accessibilityNotes              String?                     @map("accessibility_notes") @db.VarChar(1000)
