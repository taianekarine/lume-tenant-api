  @@index([companyId, aggregateType, aggregateId, aggregateSequence, status])
  @@index([companyId, createdAt])
  @@map("integration_outbox")
}

model ServiceIdentity {
  id         String              @id @default(uuid()) @db.Uuid
  companyId  String              @map("company_id") @db.Uuid
  type       ServiceIdentityType @default(N8N)
  name       String              @db.VarChar(80)
  keyId      String              @unique @map("key_id") @db.Uuid
  secretHash String              @map("secret_hash") @db.Char(64)
  enabled    Boolean             @default(true)
  lastUsedAt DateTime?           @map("last_used_at")
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, type, name])
  @@unique([id, companyId])
  @@index([companyId, enabled])
  @@map("service_identities")
}

model WhatsAppImportBatch {
  id                String                    @id @db.Uuid
  companyId         String                    @map("company_id") @db.Uuid
  channelId         String                    @map("channel_id") @db.Uuid
  actorUserId       String                    @map("actor_user_id") @db.Uuid
  name              String                    @db.VarChar(120)
  packagePath       String                    @map("package_path") @db.VarChar(1000)
  workbookSha256    String                    @map("workbook_sha256") @db.Char(64)
  packageSha256     String                    @map("package_sha256") @db.Char(64)
  cutoffAt          DateTime                  @map("cutoff_at")
  status            WhatsAppImportBatchStatus @default(APPLYING)
  expectedCounts    Json                      @map("expected_counts") @db.JsonB
  appliedCounts     Json?                     @map("applied_counts") @db.JsonB
  outboxCountBefore Int                       @map("outbox_count_before")
  outboxCountAfter  Int?                      @map("outbox_count_after")
  errorMessage      String?                   @map("error_message") @db.VarChar(1000)
  claimId           String?                   @map("claim_id") @db.Uuid
  leaseUntil        DateTime?                 @map("lease_until")
  startedAt         DateTime                  @default(now()) @map("started_at")
  appliedAt         DateTime?                 @map("applied_at")
  rolledBackAt      DateTime?                 @map("rolled_back_at")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  company      Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  channel      WhatsAppChannel             @relation(fields: [channelId, companyId], references: [id, companyId], onDelete: Restrict)
  actor        User                        @relation("WhatsAppImportActor", fields: [actorUserId, companyId], references: [id, companyId], onDelete: Restrict)
  records      WhatsAppImportRecord[]
  externalRefs WhatsAppImportExternalRef[]

  @@unique([companyId, name])
  @@unique([id, companyId])
  @@index([companyId, status, createdAt])
  @@index([status, leaseUntil])
  @@index([actorUserId, companyId, createdAt])
  @@map("whatsapp_import_batches")
}

model WhatsAppImportRecord {
  id                     String                     @id @default(uuid()) @db.Uuid
  batchId                String                     @map("batch_id") @db.Uuid
  companyId              String                     @map("company_id") @db.Uuid
  sourceSystem           String                     @map("source_system") @db.VarChar(80)
  externalConversationId String                     @map("external_conversation_id") @db.VarChar(160)
  conversationId         String                     @map("conversation_id") @db.Uuid
  contactId              String                     @map("contact_id") @db.Uuid
  action                 String                     @db.VarChar(20)
  beforeSnapshot         Json?                      @map("before_snapshot") @db.JsonB
  afterSnapshot          Json                       @map("after_snapshot") @db.JsonB
  createdResourceIds     Json                       @map("created_resource_ids") @db.JsonB
  status                 WhatsAppImportRecordStatus @default(APPLIED)
  appliedAt              DateTime                   @default(now()) @map("applied_at")
  rolledBackAt           DateTime?                  @map("rolled_back_at")

  batch   WhatsAppImportBatch @relation(fields: [batchId, companyId], references: [id, companyId], onDelete: Cascade)
  company Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([batchId, sourceSystem, externalConversationId])
  @@index([companyId, conversationId])
  @@index([companyId, status, appliedAt])
  @@map("whatsapp_import_records")
}

model WhatsAppImportExternalRef {
  id           String   @id @default(uuid()) @db.Uuid
  batchId      String   @map("batch_id") @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  entityType   String   @map("entity_type") @db.VarChar(20)
  sourceSystem String   @map("source_system") @db.VarChar(80)
  externalId   String   @map("external_id") @db.VarChar(160)
  internalId   String   @map("internal_id") @db.Uuid
  payloadHash  String?  @map("payload_hash") @db.Char(64)
  createdAt    DateTime @default(now()) @map("created_at")

  batch   WhatsAppImportBatch @relation(fields: [batchId, companyId], references: [id, companyId], onDelete: Cascade)
  company Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, entityType, sourceSystem, externalId])
  @@index([companyId, entityType, internalId])
  @@index([batchId, entityType])
  @@map("whatsapp_import_external_refs")
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  aggregateType String       @map("aggregate_type") @db.VarChar(60)
  aggregateId   String       @map("aggregate_id") @db.VarChar(100)
  eventType     String       @map("event_type") @db.VarChar(100)
  payload       Json         @db.JsonB
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now()) @map("available_at")
  deliveredAt   DateTime?    @map("delivered_at")
  lastError     String?      @map("last_error") @db.Text
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([status, availableAt])
  @@map("outbox_events")
}

model InboxReceipt {
  eventId    String   @id @map("event_id") @db.Uuid
  source     String   @db.VarChar(80)
  receivedAt DateTime @default(now()) @map("received_at")

  @@map("inbox_receipts")
}
