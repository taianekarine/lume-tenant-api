# ============================================================================
# EXECUÇÃO LOCAL — copie este arquivo para .env
# Obrigatórios para iniciar: NODE_ENV, PORT, DATABASE_URL, JWT_ACCESS_SECRET,
# INSTALLATION_ID, LICENSE_PUBLIC_KEY_BASE64 e LICENSE_DOCUMENT.
# As integrações de e-mail e WhatsApp têm requisitos adicionais nos blocos
# correspondentes quando forem habilitadas.
# Nunca versionar o .env preenchido.
# ============================================================================
NODE_ENV=development
PORT=3333

# ----------------------------------------------------------------------------
# BANCO DE DADOS — obrigatório
# O compose local publica o PostgreSQL em 127.0.0.1:5433.
# O compose de desenvolvimento usa credenciais locais fixas e não lê
# POSTGRES_DB, POSTGRES_USER ou POSTGRES_PASSWORD.
# TEST_DATABASE_URL é obrigatório apenas para a suíte E2E.
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql://lume:lume@127.0.0.1:5433/lume_tenant?schema=public
TEST_DATABASE_URL=postgresql://lume:lume@127.0.0.1:5433/lume_tenant_test?schema=public

# ----------------------------------------------------------------------------
# PRISMA STUDIO — opcional e somente administrativo
# Em loopback basta npm.cmd run prisma:studio. Banco remoto exige também
# PRISMA_STUDIO_ALLOW_REMOTE=true e confirmação exata host/banco.
# ----------------------------------------------------------------------------
PRISMA_STUDIO_PORT=5555
PRISMA_STUDIO_ALLOW_REMOTE=false
PRISMA_STUDIO_ALLOW_PRODUCTION=false
PRISMA_STUDIO_CONFIRM_TARGET=

# ----------------------------------------------------------------------------
# AUTENTICAÇÃO E SENHAS — JWT_ACCESS_SECRET é secreto e obrigatório
# Use pelo menos 32 caracteres aleatórios. Não reutilize entre ambientes.
# ----------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7
JWT_REFRESH_REMEMBER_TTL_DAYS=30
BCRYPT_ROUNDS=12
PASSWORD_CHANGE_TOKEN_TTL_MINUTES=30
PASSWORD_HISTORY_LIMIT=10
PASSWORD_RESET_URL_BASE=http://localhost:3000/reset-password
PASSWORD_RESET_MIN_RESPONSE_MS=750

# ----------------------------------------------------------------------------
# E-MAIL/RESEND — opcional localmente
# RESEND_API_KEY é segredo server-only. Ative somente com remetente autorizado.
# ----------------------------------------------------------------------------
EMAIL_DELIVERY_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@example.test
RESEND_FROM_NAME=Lume
RESEND_API_URL=https://api.resend.com
RESEND_REQUEST_TIMEOUT_MS=10000
RESEND_MAX_ATTEMPTS=2
RESEND_RETRY_DELAY_MS=150
SUPPORT_RECIPIENT_EMAIL=devops@mileniumturismo.com.br
SUPPORT_CC_EMAIL=taiane.karine@mileniumturismo.com.br,taianekas.dev@outlook.com

# ----------------------------------------------------------------------------
# HTTP, DOMÍNIOS E PROXY
# CORS_ORIGINS lista as origens do Tenant Web, separadas por vírgula.
# ----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true
TRUST_PROXY_HOPS=0
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
HTTP_MAX_JSON_BODY_BYTES=1048576

# ----------------------------------------------------------------------------
# WHATSAPP — opcional; deixe WHATSAPP_ENABLED=false sem Evolution e IA
# A regra de encerramento após aprovação está preservada, porém desabilitada.
# ----------------------------------------------------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_API_DISPATCH_INTERVAL_MS=500
WHATSAPP_API_REQUEST_TIMEOUT_MS=10000
WHATSAPP_API_EXECUTION_TIMEOUT_MS=480000
WHATSAPP_API_DISPATCH_BATCH_SIZE=20
WHATSAPP_API_RETRY_BASE_DELAY_MS=500
WHATSAPP_API_RETRY_MAX_DELAY_MS=300000
WHATSAPP_API_DEBOUNCE_MS=2000
WHATSAPP_API_DEPARTMENT_COLLECTION_MS=120000
WHATSAPP_CHANNEL_ID=
WHATSAPP_CHANNEL_NAME=WhatsApp principal
WHATSAPP_PHONE_NUMBER=
WHATSAPP_IGNORE_GROUPS=true
WHATSAPP_IGNORE_FROM_ME=true
WHATSAPP_MAX_WEBHOOK_BYTES=262144
WHATSAPP_MAX_ATTACHMENT_BYTES=10485760
WHATSAPP_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/plain,text/csv,application/octet-stream,audio/ogg,audio/mpeg,audio/mp4,audio/aac,audio/wav,video/mp4,video/webm,video/quicktime
WHATSAPP_MEDIA_STORAGE_DRIVER=filesystem
# Opcional em desenvolvimento. Se vazio, usa ./var/whatsapp-media.
WHATSAPP_MEDIA_STORAGE_PATH=
WHATSAPP_IMPORT_ROOT=./var/imports/whatsapp
WHATSAPP_RETENTION_DAYS=365
WHATSAPP_FOLLOW_UP_INACTIVITY_MS=1800000
WHATSAPP_PREVENT_CLOSE_WITH_APPROVED_QUOTE=false
INTEGRATION_RETENTION_DAYS=90
RETENTION_JOB_ENABLED=true

# ----------------------------------------------------------------------------
# EVOLUTION API — obrigatório quando WHATSAPP_ENABLED=true
# API key e webhook secret são segredos. O secret deve ter 32+ caracteres.
# ----------------------------------------------------------------------------
EVOLUTION_PROVIDER_NAME=Evolution API
EVOLUTION_BASE_URL=
EVOLUTION_INSTANCE_NAME=
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=
EVOLUTION_SEND_TEXT_PAYLOAD_MODE=number-text
EVOLUTION_SEND_TEXT_TIMEOUT_MS=10000
EVOLUTION_SEND_MEDIA_TIMEOUT_MS=30000
EVOLUTION_MEDIA_CONTENT_TIMEOUT_MS=30000
WEBHOOK_MAX_SKEW_MS=300000
WEBHOOK_MAX_EVENT_AGE_MS=604800000
EVOLUTION_DISPATCH_LEASE_MS=90000

# ----------------------------------------------------------------------------
# AUTOMAÇÃO WHATSAPP NA API — obrigatória quando WHATSAPP_ENABLED=true
# A ordem aceita openai,cerebras,gemini,groq. Configure ao menos uma chave.
# ----------------------------------------------------------------------------
WHATSAPP_AI_PROVIDER_ORDER=openai,cerebras,gemini,groq
WHATSAPP_AI_REQUEST_TIMEOUT_MS=90000
WHATSAPP_AI_OPENAI_API_KEY=
WHATSAPP_AI_OPENAI_BASE_URL=https://api.openai.com/v1
WHATSAPP_AI_OPENAI_MODEL=gpt-5.5
WHATSAPP_AI_CEREBRAS_API_KEY=
WHATSAPP_AI_CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
WHATSAPP_AI_CEREBRAS_MODEL=gpt-oss-120b
WHATSAPP_AI_GEMINI_API_KEY=
WHATSAPP_AI_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
WHATSAPP_AI_GEMINI_MODEL=gemini-2.5-flash
WHATSAPP_AI_GROQ_API_KEY=
WHATSAPP_AI_GROQ_BASE_URL=https://api.groq.com/openai/v1
WHATSAPP_AI_GROQ_MODEL=llama-3.3-70b-versatile
MILENIUM_DEPARTMENT_PURCHASES_PHONE=
MILENIUM_DEPARTMENT_CONTROLLING_PHONE=
MILENIUM_DEPARTMENT_DP_PHONE=
MILENIUM_DEPARTMENT_FINANCE_PHONE=
MILENIUM_DEPARTMENT_MANAGEMENT_PHONE=
MILENIUM_DEPARTMENT_MAINTENANCE_PHONE=
MILENIUM_DEPARTMENT_MONITORING_PHONE=
MILENIUM_DEPARTMENT_OPERATIONAL_PHONE=

# ----------------------------------------------------------------------------
# IMPORTAÇÃO/EXPORTAÇÃO TEMPORÁRIA DE ARQUIVOS
# Limites protegem memória, CPU e armazenamento por tenant.
# ----------------------------------------------------------------------------
DATA_EXCHANGE_MAX_FILE_BYTES=26214400
DATA_EXCHANGE_MAX_TENANT_BYTES=262144000
DATA_EXCHANGE_RETENTION_DAYS=30

# ----------------------------------------------------------------------------
# REVISÃO DOCUMENTAL — OpenAI é opcional; sem chave usa fallback estrutural local.
# A chave permanece exclusivamente na Tenant API.
# ----------------------------------------------------------------------------
DOCUMENT_REVIEW_ENABLED=false
DOCUMENT_REVIEW_PROVIDER=local
OPENAI_API_KEY=
OPENAI_DOCUMENT_MODEL=gpt-5.6-terra
OPENAI_DOCUMENT_TIMEOUT_MS=90000
OPENAI_DOCUMENT_MAX_ATTEMPTS=3
OPENAI_API_BASE_URL=https://api.openai.com/v1

# ----------------------------------------------------------------------------
# LICENÇA OFFLINE — obrigatória após provisionamento pelo Lume Control
# LICENSE_DOCUMENT é secreto e não deve ser enviado ao frontend.
# ----------------------------------------------------------------------------
INSTALLATION_ID=
LICENSE_PUBLIC_KEY_BASE64=
LICENSE_DOCUMENT=

# ----------------------------------------------------------------------------
# BOOTSTRAP DO TENANT — obrigatório somente na primeira inicialização
# Remova TENANT_ADMIN_PASSWORD do ambiente após o bootstrap bem-sucedido.
# ----------------------------------------------------------------------------
TENANT_LEGAL_NAME=
TENANT_TRADE_NAME=
TENANT_TAX_ID=
TENANT_ADMIN_NAME=
TENANT_ADMIN_USERNAME=
TENANT_ADMIN_EMAIL=
TENANT_ADMIN_CPF=
TENANT_ADMIN_PASSWORD=
